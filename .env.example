# --- LangSmith (optional tracing; prompts fall back to /prompts/*.md) ---
# No "Temporal workspace id" concept exists for local self-hosted Temporal —
# that field only applies to Temporal Cloud. LANGSMITH_WORKSPACE_ID below is
# only needed if your LangSmith account has multiple workspaces.
LANGSMITH_API_KEY=lsv2_pt_your_api_key_here
LANGSMITH_WORKSPACE_ID=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=agentic-sdlc
LANGSMITH_TRACING=false

# --- LiteLLM proxy (all agent/judge LLM traffic) ---
# In docker-compose use http://litellm:4000; on host use http://localhost:4000
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-agentic-sdlc-local
LITELLM_MODEL_DEFAULT=gpt-4o-mini
LITELLM_MODEL_JUDGE=gpt-4o-mini
LITELLM_MODEL_EMBEDDING=text-embedding-3-small

# Upstream keys consumed ONLY by the LiteLLM container (not by agents directly)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Temporal ---
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE_WORKFLOWS=sdlc-workflows
TEMPORAL_TASK_QUEUE_AGENTS=agent-activities
TEMPORAL_TASK_QUEUE_POLICY=policy-activities
TEMPORAL_TASK_QUEUE_AUDIT=audit-activities

# --- Data plane ---
DATABASE_URL=postgresql+asyncpg://sdlc:sdlc@localhost:5432/sdlc
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sdlc-audit
MINIO_SECURE=false
AUDIT_FS_FALLBACK_DIR=./data/audit
ARTIFACTS_DIR=./artifacts

# --- Policy ---
OPA_URL=http://localhost:8181
JUDGE_PASS_THRESHOLD=0.7
COVERAGE_MIN=0.6
REPLAN_MAX=3

# --- API / frontend ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEMO_MODE_DEFAULT=false
